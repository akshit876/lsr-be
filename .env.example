# # Server Configuration
# PORT=3002
# NODE_ENV=development

# MongoDB Configuration
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DATABASE=main-data
MONGODB_COLLECTION=records
# Optional: cap driver pool on 16GB dev PCs (e.g. 10) when Next.js + lsr-be both run
# MONGODB_MAX_POOL_SIZE=10

# Scanner Configuration
BARCODE_RESET_HOUR=6
BARCODE_RESET_MINUTE=0
SCAN_TIMEOUT=100000
CODE_FILE_PATH=./data/code.txt

# Modbus Configuration
MODBUS_HOST=192.168.3.146
MODBUS_PORT=502

# Logging Configuration
LOG_LEVEL=info

SERIAL_PORT=COM5