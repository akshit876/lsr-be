# PLC Modbus TCP (holding registers / bits)
MODBUS_HOST=192.168.119.175
MODBUS_PORT=502
# Aliases also supported: MODBUS_IP, NEXT_PUBLIC_MODBUS_IP

# TCP barcode scanner (verification / second scan)
SCANNER_HOST=192.168.119.176
SCANNER_PORT=9004

# After second scan: ASCII packed into holding registers (2 chars per register)
# Default start address 3000; increase SCANNER_DATA_MAX_CHARS if string is longer
SCANNER_DATA_REGISTER_START=3000
SCANNER_DATA_MAX_CHARS=120
