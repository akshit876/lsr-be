{
  "name": "laser-be",
  "version": "1.0.0",
  "main": "server.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node server.js",
    "build": "pkg . --targets node18-win-x64 --output dist/laser-be.exe",
    "build:debug": "pkg . --targets node18-win-x64 --output dist/laser-be.exe --debug",
    "build:all": "pkg . --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --output dist/laser-be"
  },
  "bin": "server.js",
  "pkg": {
    "assets": [
      "node_modules/**/*",
      ".env",
      "**/*.node"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "async": "^3.2.6",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.20.0",
    "clsx": "^2.1.1",
    "csv": "^6.3.10",
    "csv-writer": "^1.6.0",
    "date-fns": "^2.30.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "json2csv": "^6.0.0-alpha.2",
    "lowdb": "^7.0.1",
    "modbus-serial": "^8.0.17",
    "mongodb": "^6.9.0",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "robotjs": "^0.6.0",
    "serialport": "^12.0.0",
    "socket.io": "^4.7.5",
